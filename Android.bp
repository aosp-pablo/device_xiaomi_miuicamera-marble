soong_namespace {
}

android_app_import {
    name: "MiuiCalculator",
    owner: "xiaomi",
    apk: "prebuilts/MiuiCalculator.apk",
    preprocessed: true,
    presigned: true,
    overrides: ["ExactCalculator","CalculatorGoogle","CalculatorGooglePrebuilt","CalculatorGooglePrebuilt_85006267"],
    dex_preopt: {
        enabled: false,
    },
    product_specific: true,
}

android_app_import {
    name: "MiuiGallery",
    owner: "xiaomi",
    apk: "prebuilts/MiuiGallery.apk",
    certificate: "platform",
    dex_preopt: {
        enabled: false,
    },
    product_specific: true,
}

android_app_import {
    name: "MiuiGalleryEditor",
    owner: "xiaomi",
    apk: "prebuilts/MiuiGalleryEditor.apk",
    certificate: "platform",
    dex_preopt: {
        enabled: false,
    },
    product_specific: true,
}
